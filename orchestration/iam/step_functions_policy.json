{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageOlistGlueJob",
      "Effect": "Allow",
      "Action": [
        "glue:StartJobRun",
        "glue:GetJobRun",
        "glue:GetJobRuns",
        "glue:BatchStopJobRun"
      ],
      "Resource": "arn:aws:glue:us-east-1:214654654308:job/olist-transform-orders"
    },
    {
      "Sid": "ManageOlistAnalyticsCrawler",
      "Effect": "Allow",
      "Action": [
        "glue:StartCrawler",
        "glue:GetCrawler"
      ],
      "Resource": "arn:aws:glue:us-east-1:214654654308:crawler/olist_analytics_crawler"
    }
  ]
}